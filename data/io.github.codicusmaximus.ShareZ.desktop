[Desktop Entry]
Name=ShareZ
Comment=Capture and record your screen
Exec=sharez
Icon=applets-screenshooter
Terminal=false
Type=Application
Categories=Utility;Graphics;
Keywords=screenshot;screen;capture;record;screencast;
StartupNotify=true
X-GNOME-UsesNotifications=true
# KWin only lets apps that ask here capture a single window.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Actions=capture;record;

[Desktop Action capture]
Name=Capture Region
Exec=sharez --capture

[Desktop Action record]
Name=Record Region
Exec=sharez --record
